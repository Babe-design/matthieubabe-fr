---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import MagnetPlayground from "../components/MagnetPlayground.astro";
import DrawingPad from "../components/DrawingPad.astro";
import GummyPlayground from "../components/GummyPlayground.astro";
import SensitivitySlider from "../components/SensitivitySlider.astro";

const experiments = [
  { label: "AI Guard sensitivity", Card: SensitivitySlider },
  { label: "Yellow gummy b", Card: GummyPlayground },
  { label: "Drawing pad", Card: DrawingPad },
  { label: "Fridge magnets", Card: MagnetPlayground },
];
---
<PortfolioLayout section="experiment">
  <ol class="experiment-feed" aria-label="Experiments">
    {experiments.map(({ label, Card }, index) => <li class="portfolio-reveal" style={`--reveal-index:${index}`}>
      <article class="experiment-entry" aria-label={label}>
        <Card />
      </article>
    </li>)}
  </ol>
</PortfolioLayout>
