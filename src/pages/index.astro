---
import SiteLayout from "../layouts/SiteLayout.astro";
import Signature from "../components/Signature.astro";
import { site } from "../data/site";
---
<SiteLayout home description={`${site.intro} ${site.currentRole}`}>
  <main id="content" class="home-content">
    <h1 class="sr-only">Matthieu Babe</h1>
    <div class="intro">
      <p class="intro-line">{site.intro}</p>
      <p class="intro-role">{site.currentRole}</p>
    </div>
  </main>
  <Signature />
</SiteLayout>
