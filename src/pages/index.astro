---
import SiteLayout from "../layouts/SiteLayout.astro";
import Signature from "../components/Signature.astro";
import { site } from "../data/site";
---
<SiteLayout home description={`${site.intro} ${site.currentRole}`}>
  <main id="content" class="home-content">
    <h1 class="sr-only">Matthieu Babe</h1>
    <div class="intro">
      <p class="intro-line">{site.intro}</p>
      <p class="intro-role">Currently leading design for Security at <a class="datadog-link" href="https://www.datadoghq.com/product/security-platform/">Datadog</a>.</p>
      <p class="status-note">
        <span class="sr-only">// Still caramelising</span>
        <code class="typewriter" aria-hidden="true">
          <span class="typewriter-measure">// Still caramelising</span>
          <span class="typewriter-line"><span class="typewriter-text">// Still caramelising</span><span class="typing-cursor"></span></span>
        </code>
      </p>
    </div>
  </main>
  <Signature />
</SiteLayout>
