---
import Analytics from '@vercel/analytics/astro';

const pageTitle = "Matthieu Babe";
const pageDescription =
  "Matthieu Babe is reworking this place. A quieter, more personal site is coming soon.";
const siteUrl = "https://matthieubabe.fr";
const socialImage = `${siteUrl}/social/og-image.png`;

const socialLinks = [
  {
    name: "X",
    href: "https://x.com/BabeMatthieu",
    icon: "x"
  },
  {
    name: "Threads",
    href: "https://www.threads.com/@matthieubabe",
    icon: "threads"
  },
  {
    name: "Dribbble",
    href: "https://dribbble.com/matthieubabe",
    icon: "dribbble"
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/matthieubabe",
    icon: "linkedin"
  }
];

const backgroundOptions = [
  {
    id: "paper",
    label: "Dotted paper background"
  },
  {
    id: "cutting",
    label: "Cutting mat background"
  },
  {
    id: "blueprint",
    label: "Blueprint background"
  }
];
---

<!doctype html>
<html lang="en" data-background="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={siteUrl} />
    <Analytics />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Handwritten Matthieu Babe label on dotted paper" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Handwritten Matthieu Babe label on dotted paper" />

    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        try {
          const savedBackground = localStorage.getItem("matthieu-background");
          if (["paper", "cutting", "blueprint"].includes(savedBackground)) {
            document.documentElement.dataset.background = savedBackground;
          }
        } catch {
          document.documentElement.dataset.background = "paper";
        }
      })();
    </script>
  </head>
  <body>
    <svg
      class="glass-filter-defs"
      aria-hidden="true"
      focusable="false"
      width="0"
      height="0"
    >
      <filter
        id="liquid-glass-refraction"
        x="-30%"
        y="-30%"
        width="160%"
        height="160%"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.018 0.032"
          numOctaves="2"
          seed="17"
          result="grain"
        />
        <feGaussianBlur in="grain" stdDeviation="1.35" result="softGrain" />
        <feDisplacementMap
          in="SourceGraphic"
          in2="softGrain"
          scale="17"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>
    </svg>
    <main class="page" aria-labelledby="page-title">
      <h1 id="page-title" class="sr-only">Matthieu Babe</h1>
      <p class="sr-only">I'm reworking this place.</p>
      <img
        class="name-tape-image"
        src="/images/name-tape.png"
        alt=""
        width="1500"
        height="339"
        loading="eager"
        decoding="async"
        draggable="false"
        aria-hidden="true"
      />
      <section class="composition">
        <div class="post-it-wrap" aria-hidden="true">
          <img
            class="post-it-image"
            src="/images/post-it-reworking.png"
            alt=""
            width="1200"
            height="1200"
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </div>
      </section>

      <div class="background-switcher" role="group" aria-label="Background style">
        {
          backgroundOptions.map((option) => (
            <button
              class={`background-button background-button-${option.id}`}
              type="button"
              data-background-option={option.id}
              aria-label={option.label}
              aria-pressed={option.id === "paper" ? "true" : "false"}
              title={option.label}
            >
              <span class="background-swatch" aria-hidden="true" />
            </button>
          ))
        }
      </div>

      <nav class="socials" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              class={`social-link social-link-${link.icon}`}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.name} profile`}
              title={link.name}
            >
              {link.icon === "x" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.7 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.3-5.6 6.3H2.1l7.3-8.3L1.8 3h6.4l4.4 5.7L17.7 3Zm-1.1 16.2h1.7L7.3 4.7H5.4l11.2 14.5Z" />
                </svg>
              )}
              {link.icon === "threads" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.1 2.1c3.2 0 5.8 1.4 7.3 4l-1.9 1.3c-1.2-2-3-3-5.4-3-3.7 0-6.3 3-6.3 7.6s2.6 7.6 6.4 7.6c3.3 0 5.9-2 5.9-4.6 0-1.5-.8-2.5-2.3-3.1-.4 3-2.1 4.7-4.7 4.7-2.2 0-3.8-1.3-3.8-3.2 0-2.1 1.8-3.4 4.7-3.4.5 0 1 0 1.5.1-.3-1.7-1.2-2.6-2.8-2.6-1.2 0-2.2.4-3.2 1.2L6.4 6.9c1.2-1 2.7-1.5 4.3-1.5 3 0 4.8 1.8 5.2 5.2 2.8.8 4.4 2.4 4.4 4.5 0 3.8-3.4 6.6-8.1 6.6-5.2 0-8.7-3.9-8.7-9.8s3.5-9.8 8.6-9.8Zm-.8 12.4c1.3 0 2.1-.8 2.3-2.4-.6-.1-1.1-.2-1.6-.2-1.6 0-2.5.5-2.5 1.4 0 .7.7 1.2 1.8 1.2Z" />
                </svg>
              )}
              {link.icon === "dribbble" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.2a9.8 9.8 0 1 0 0 19.6 9.8 9.8 0 0 0 0-19.6Zm6.4 4.5a7.8 7.8 0 0 1 1.7 4.8c-1.8-.4-3.5-.4-5.1-.1-.2-.5-.4-1-.7-1.5 1.6-.7 2.9-1.8 4.1-3.2ZM12 4.1c1.9 0 3.6.7 4.9 1.8-1 1.2-2.2 2-3.6 2.6-1-1.8-2-3.2-2.7-4.3.5-.1.9-.1 1.4-.1Zm-3.5.8c.8 1.1 1.8 2.5 2.8 4.2-1.9.6-4.1.8-6.6.8.6-2.3 2-4.1 3.8-5Zm-4.4 7V12c0-.1 0-.2.1-.3 3 0 5.7-.3 8-1 .2.4.4.8.6 1.3-3.2 1-5.7 2.9-7.4 5.6a7.8 7.8 0 0 1-1.3-5.7Zm8 8a7.6 7.6 0 0 1-5.2-2.1c1.5-2.5 3.7-4.1 6.5-5 .8 2.2 1.4 4.4 1.7 6.5-1 .4-2 .6-3 .6Zm4.8-1.6a27.5 27.5 0 0 0-1.6-5.9c1.5-.2 3.1-.1 4.8.3a7.8 7.8 0 0 1-3.2 5.6Z" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5.2 8.9h3.3V20H5.2V8.9Zm1.7-5.4c1.1 0 1.9.7 1.9 1.7S8 7 6.9 7 5 6.3 5 5.3s.8-1.8 1.9-1.8ZM10.7 8.9h3.1v1.5h.1c.4-.8 1.5-1.8 3.1-1.8 3.3 0 3.9 2.2 3.9 5V20h-3.3v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V20h-3.3V8.9Z" />
                </svg>
              )}
              <span>{link.name}</span>
            </a>
          ))
        }
      </nav>
    </main>
    <script is:inline>
      (() => {
        const allowedBackgrounds = ["paper", "cutting", "blueprint"];
        const themeColors = {
          paper: "#ffffff",
          cutting: "#063826",
          blueprint: "#0a3d66"
        };
        const root = document.documentElement;
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        const buttons = Array.from(
          document.querySelectorAll("[data-background-option]")
        );

        const applyBackground = (nextBackground, shouldPersist = true) => {
          const background = allowedBackgrounds.includes(nextBackground)
            ? nextBackground
            : "paper";

          root.dataset.background = background;
          if (metaTheme) {
            metaTheme.setAttribute("content", themeColors[background]);
          }
          buttons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.backgroundOption === background)
            );
          });

          if (!shouldPersist) {
            return;
          }

          try {
            localStorage.setItem("matthieu-background", background);
          } catch {
            /* Preference persistence is a nice-to-have. */
          }
        };

        applyBackground(root.dataset.background, false);
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            applyBackground(button.dataset.backgroundOption);
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --dot: rgba(39, 39, 37, 0.16);
    --ink: #1c1a17;
    --page-background-color: var(--paper);
    --page-background-image: radial-gradient(circle at center, var(--dot) 0 1.45px, transparent 1.6px);
    --page-background-size: 42px 42px;
    --page-background-position: 0 0;
    --page-background-repeat: repeat;
  }

  html[data-background="cutting"] {
    --page-background-color: #063826;
    --page-background-image:
      linear-gradient(180deg, rgba(1, 16, 11, 0.16), rgba(1, 16, 11, 0.28)),
      url("/images/background-cutting-mat.svg");
    --page-background-size: cover, cover;
    --page-background-position: center, center;
    --page-background-repeat: no-repeat, no-repeat;
  }

  html[data-background="blueprint"] {
    --page-background-color: #0a3d66;
    --page-background-image:
      linear-gradient(180deg, rgba(2, 13, 27, 0.1), rgba(2, 13, 27, 0.22)),
      url("/images/background-blueprint.svg");
    --page-background-size: cover, cover;
    --page-background-position: center, center;
    --page-background-repeat: no-repeat, no-repeat;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    min-height: 100%;
    background: var(--paper);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  body {
    min-height: 100%;
    margin: 0;
    color: var(--ink);
    background: var(--paper);
  }

  a {
    color: inherit;
  }

  .page {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow-x: hidden;
    isolation: isolate;
    padding:
      max(1.25rem, env(safe-area-inset-top))
      clamp(1rem, 4vw, 3.5rem)
      max(1.25rem, env(safe-area-inset-bottom));
    background-color: var(--page-background-color);
    background-image: var(--page-background-image);
    background-position: var(--page-background-position);
    background-repeat: var(--page-background-repeat);
    background-size: var(--page-background-size);
    transition: background-color 220ms ease;
  }

  .glass-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .composition {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    align-content: center;
    width: min(100%, 42rem);
    min-height: clamp(20rem, 58svh, 32rem);
    padding:
      clamp(3.8rem, 11vh, 5.8rem)
      clamp(0.75rem, 4vw, 2.4rem)
      clamp(4.4rem, 12vh, 6rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .name-tape-image {
    position: absolute;
    top: max(0.8rem, env(safe-area-inset-top));
    left: 50%;
    z-index: 3;
    display: block;
    width: clamp(12rem, 24vw, 20rem);
    max-width: 76vw;
    height: auto;
    filter:
      drop-shadow(0 0.15rem 0.08rem rgba(42, 31, 18, 0.12))
      drop-shadow(0.18rem 0.28rem 0.28rem rgba(42, 31, 18, 0.08));
    transform: translateX(-50%) rotate(-2.8deg);
    user-select: none;
    -webkit-user-drag: none;
  }

  .post-it-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: max-content;
    max-width: 100%;
  }

  .post-it-wrap::before {
    content: none;
  }

  .post-it-image {
    z-index: 1;
    display: block;
    width: clamp(13rem, 26vw, 18.5rem);
    max-width: 100%;
    height: auto;
    filter: none;
    transform: rotate(-3.2deg);
    user-select: none;
    -webkit-user-drag: none;
  }

  .background-switcher {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.34rem;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.24) 46%, rgba(255, 255, 255, 0.52)),
      rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(26px) saturate(1.9) brightness(1.08);
    backdrop-filter: blur(26px) saturate(1.9) brightness(1.08);
    box-shadow:
      0 1.1rem 2.6rem rgba(28, 25, 20, 0.14),
      0 0.22rem 0.62rem rgba(28, 25, 20, 0.08),
      inset 0 1px 1px rgba(255, 255, 255, 0.92),
      inset 0 -1px 1px rgba(255, 255, 255, 0.34),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.64);
    isolation: isolate;
    overflow: hidden;
  }

  .background-switcher::before,
  .background-switcher::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    content: "";
  }

  .background-switcher::before {
    z-index: -1;
    background:
      radial-gradient(circle at 20% 14%, rgba(255, 255, 255, 0.9), transparent 32%),
      linear-gradient(115deg, transparent 10%, rgba(255, 255, 255, 0.52) 25%, transparent 47%);
    opacity: 0.68;
    mix-blend-mode: screen;
  }

  .background-switcher::after {
    z-index: 0;
    box-shadow:
      inset 1px 1px 1.5px rgba(255, 255, 255, 0.82),
      inset -1px -1px 1.5px rgba(255, 255, 255, 0.2);
  }

  @supports ((backdrop-filter: url("#liquid-glass-refraction")) or (-webkit-backdrop-filter: url("#liquid-glass-refraction"))) {
    .background-switcher {
      -webkit-backdrop-filter: url("#liquid-glass-refraction") blur(22px) saturate(1.95) brightness(1.08);
      backdrop-filter: url("#liquid-glass-refraction") blur(22px) saturate(1.95) brightness(1.08);
    }
  }

  .background-button {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background:
      radial-gradient(circle at 32% 18%, rgba(255, 255, 255, 0.42), transparent 38%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.015) 56%, rgba(255, 255, 255, 0.1)),
      rgba(255, 255, 255, 0.02);
    box-shadow:
      inset 0 1px 0.75px rgba(255, 255, 255, 0.34),
      inset 0 -1px 1px rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .background-button::before,
  .background-button::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    content: "";
  }

  .background-button::before {
    background:
      linear-gradient(122deg, transparent 15%, rgba(255, 255, 255, 0.48) 33%, transparent 51%),
      radial-gradient(circle at 76% 18%, rgba(255, 255, 255, 0.44), transparent 29%);
    opacity: 0.36;
    transform: translateX(-8%) rotate(-7deg);
  }

  .background-button::after {
    box-shadow:
      inset 0.75px 0.75px 1px rgba(255, 255, 255, 0.34),
      inset 0 0 11px rgba(255, 255, 255, 0.08);
  }

  .background-button:hover {
    background:
      radial-gradient(circle at 28% 14%, rgba(255, 255, 255, 0.9), transparent 36%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0.06) 58%, rgba(255, 255, 255, 0.24)),
      rgba(255, 255, 255, 0.12);
    transform: translateY(-1px) scale(1.035);
  }

  .background-button:focus-visible {
    outline: 0;
    box-shadow:
      0 0 0 2px rgba(255, 255, 255, 0.94),
      0 0 0 4px rgba(28, 26, 23, 0.58),
      inset 0 1px 0.75px rgba(255, 255, 255, 0.95),
      inset 0 -1px 1px rgba(255, 255, 255, 0.28),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.44);
  }

  .background-button[aria-pressed="true"] {
    background:
      radial-gradient(circle at 32% 18%, rgba(255, 255, 255, 0.95), transparent 36%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0.16) 58%, rgba(255, 255, 255, 0.38)),
      rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 0 1px 0.75px rgba(255, 255, 255, 0.95),
      inset 0 -1px 1px rgba(255, 255, 255, 0.28),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.54),
      0 0.24rem 0.8rem rgba(28, 25, 20, 0.08);
  }

  .background-swatch {
    position: relative;
    z-index: 1;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 999px;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.46),
      0 0.08rem 0.22rem rgba(28, 25, 20, 0.18);
    overflow: hidden;
  }

  .background-button-paper .background-swatch {
    background:
      radial-gradient(circle, rgba(39, 39, 37, 0.26) 0 1.3px, transparent 1.5px) 1px 1px / 7px 7px,
      #ffffff;
  }

  .background-button-cutting .background-swatch {
    background:
      linear-gradient(rgba(88, 242, 191, 0.32) 1px, transparent 1px) 0 0 / 7px 7px,
      linear-gradient(90deg, rgba(88, 242, 191, 0.32) 1px, transparent 1px) 0 0 / 7px 7px,
      linear-gradient(135deg, #073824, #087254);
  }

  .background-button-blueprint .background-swatch {
    background:
      linear-gradient(rgba(232, 251, 255, 0.46) 1px, transparent 1px) 0 0 / 7px 7px,
      linear-gradient(90deg, rgba(232, 251, 255, 0.46) 1px, transparent 1px) 0 0 / 7px 7px,
      linear-gradient(135deg, #0b3459, #1681b8);
  }

  .socials {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 3;
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(0.28rem, 0.8vw, 0.42rem);
    width: auto;
    padding: 0.36rem;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.22) 44%, rgba(255, 255, 255, 0.5)),
      rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(26px) saturate(1.9) brightness(1.08);
    backdrop-filter: blur(26px) saturate(1.9) brightness(1.08);
    box-shadow:
      0 1.1rem 2.6rem rgba(28, 25, 20, 0.14),
      0 0.22rem 0.62rem rgba(28, 25, 20, 0.08),
      inset 0 1px 1px rgba(255, 255, 255, 0.92),
      inset 0 -1px 1px rgba(255, 255, 255, 0.34),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.64);
    isolation: isolate;
    overflow: hidden;
  }

  .socials::before,
  .socials::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    content: "";
  }

  .socials::before {
    z-index: -1;
    background:
      radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.92), transparent 31%),
      radial-gradient(circle at 84% 86%, rgba(255, 255, 255, 0.3), transparent 36%),
      linear-gradient(115deg, transparent 8%, rgba(255, 255, 255, 0.62) 21%, transparent 42%);
    opacity: 0.72;
    mix-blend-mode: screen;
  }

  .socials::after {
    z-index: 0;
    box-shadow:
      inset 1px 1px 1.5px rgba(255, 255, 255, 0.82),
      inset -1px -1px 1.5px rgba(255, 255, 255, 0.2);
  }

  @supports ((backdrop-filter: url("#liquid-glass-refraction")) or (-webkit-backdrop-filter: url("#liquid-glass-refraction"))) {
    .socials {
      -webkit-backdrop-filter: url("#liquid-glass-refraction") blur(22px) saturate(1.95) brightness(1.08);
      backdrop-filter: url("#liquid-glass-refraction") blur(22px) saturate(1.95) brightness(1.08);
    }
  }

  .social-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.95rem;
    min-height: 2.95rem;
    padding: 0.72rem;
    border: 0;
