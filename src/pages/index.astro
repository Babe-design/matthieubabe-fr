---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

const pageTitle = "Matthieu Babe";
const pageDescription =
  "Matthieu Babe is reworking this place. A quieter, more personal site is coming soon.";
const siteUrl = "https://matthieubabe.fr";
const socialImage = `${siteUrl}/social/og-image.png`;

const socialLinks = [
  {
    name: "X",
    href: "https://x.com/BabeMatthieu",
    icon: "x"
  },
  {
    name: "Threads",
    href: "https://www.threads.com/@matthieubabe",
    icon: "threads"
  },
  {
    name: "Dribbble",
    href: "https://dribbble.com/matthieubabe",
    icon: "dribbble"
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/matthieubabe",
    icon: "linkedin"
  }
];

---

<!doctype html>
<html lang="en" data-background="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={siteUrl} />
    <Analytics />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Handwritten Matthieu Babe label on dotted paper" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Handwritten Matthieu Babe label on dotted paper" />

    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      as="image"
      href="/images/post-it-reworking-1200.png"
      imagesrcset="/images/post-it-reworking-1200.png 1200w, /images/post-it-reworking-2000.png 2000w"
      imagesizes="(max-height: 650px) 14rem, (max-width: 720px) 68vw, 18.5rem"
    />
    <script is:inline>
      (() => {
        const allowedBackgrounds = ["paper", "cutting", "blueprint"];
        const themeColors = {
          paper: "#ffffff",
          cutting: "#063826",
          blueprint: "#0a3d66"
        };
        const root = document.documentElement;
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        const background = allowedBackgrounds[Math.floor(Math.random() * allowedBackgrounds.length)];

        root.dataset.background = background;
        if (metaTheme) {
          metaTheme.setAttribute("content", themeColors[background]);
        }
      })();
    </script>
  </head>
  <body>
    <main class="page" aria-labelledby="page-title">
      <h1 id="page-title" class="sr-only">Matthieu Babe</h1>
      <p class="sr-only">I'm reworking this place.</p>
      <img
        class="name-tape-image"
        src="/images/name-tape.png"
        alt=""
        width="1500"
        height="339"
        loading="eager"
        decoding="async"
        draggable="false"
        aria-hidden="true"
      />
      <section class="composition">
        <div class="post-it-wrap" aria-hidden="true">
          <img
            class="post-it-image"
            src="/images/post-it-reworking-1200.png"
            srcset="/images/post-it-reworking-1200.png 1200w, /images/post-it-reworking-2000.png 2000w"
            sizes="(max-height: 650px) 14rem, (max-width: 720px) 68vw, 18.5rem"
            alt=""
            width="2000"
            height="2000"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            draggable="false"
          />
        </div>
      </section>

      <nav class="socials" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              class={`social-link social-link-${link.icon}`}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.name} profile`}
              title={link.name}
            >
              {link.icon === "x" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.7 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.3-5.6 6.3H2.1l7.3-8.3L1.8 3h6.4l4.4 5.7L17.7 3Zm-1.1 16.2h1.7L7.3 4.7H5.4l11.2 14.5Z" />
                </svg>
              )}
              {link.icon === "threads" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.1 2.1c3.2 0 5.8 1.4 7.3 4l-1.9 1.3c-1.2-2-3-3-5.4-3-3.7 0-6.3 3-6.3 7.6s2.6 7.6 6.4 7.6c3.3 0 5.9-2 5.9-4.6 0-1.5-.8-2.5-2.3-3.1-.4 3-2.1 4.7-4.7 4.7-2.2 0-3.8-1.3-3.8-3.2 0-2.1 1.8-3.4 4.7-3.4.5 0 1 0 1.5.1-.3-1.7-1.2-2.6-2.8-2.6-1.2 0-2.2.4-3.2 1.2L6.4 6.9c1.2-1 2.7-1.5 4.3-1.5 3 0 4.8 1.8 5.2 5.2 2.8.8 4.4 2.4 4.4 4.5 0 3.8-3.4 6.6-8.1 6.6-5.2 0-8.7-3.9-8.7-9.8s3.5-9.8 8.6-9.8Zm-.8 12.4c1.3 0 2.1-.8 2.3-2.4-.6-.1-1.1-.2-1.6-.2-1.6 0-2.5.5-2.5 1.4 0 .7.7 1.2 1.8 1.2Z" />
                </svg>
              )}
              {link.icon === "dribbble" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.2a9.8 9.8 0 1 0 0 19.6 9.8 9.8 0 0 0 0-19.6Zm6.4 4.5a7.8 7.8 0 0 1 1.7 4.8c-1.8-.4-3.5-.4-5.1-.1-.2-.5-.4-1-.7-1.5 1.6-.7 2.9-1.8 4.1-3.2ZM12 4.1c1.9 0 3.6.7 4.9 1.8-1 1.2-2.2 2-3.6 2.6-1-1.8-2-3.2-2.7-4.3.5-.1.9-.1 1.4-.1Zm-3.5.8c.8 1.1 1.8 2.5 2.8 4.2-1.9.6-4.1.8-6.6.8.6-2.3 2-4.1 3.8-5Zm-4.4 7V12c0-.1 0-.2.1-.3 3 0 5.7-.3 8-1 .2.4.4.8.6 1.3-3.2 1-5.7 2.9-7.4 5.6a7.8 7.8 0 0 1-1.3-5.7Zm8 8a7.6 7.6 0 0 1-5.2-2.1c1.5-2.5 3.7-4.1 6.5-5 .8 2.2 1.4 4.4 1.7 6.5-1 .4-2 .6-3 .6Zm4.8-1.6a27.5 27.5 0 0 0-1.6-5.9c1.5-.2 3.1-.1 4.8.3a7.8 7.8 0 0 1-3.2 5.6Z" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5.2 8.9h3.3V20H5.2V8.9Zm1.7-5.4c1.1 0 1.9.7 1.9 1.7S8 7 6.9 7 5 6.3 5 5.3s.8-1.8 1.9-1.8ZM10.7 8.9h3.1v1.5h.1c.4-.8 1.5-1.8 3.1-1.8 3.3 0 3.9 2.2 3.9 5V20h-3.3v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V20h-3.3V8.9Z" />
                </svg>
              )}
              <span>{link.name}</span>
            </a>
          ))
        }
      </nav>
    </main>
    <script>
      import "../scripts/liquid-glass-controls";
    </script>
    <SpeedInsights />
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --dot: rgba(39, 39, 37, 0.16);
    --ink: #1c1a17;
    --page-background-color: var(--paper);
    --page-background-image: radial-gradient(circle at center, var(--dot) 0 1.45px, transparent 1.6px);
    --page-background-size: 42px 42px;
    --page-background-position: 0 0;
    --page-background-repeat: repeat;
    --control-surface: rgba(43, 43, 45, 0.74);
    --control-border: rgba(255, 255, 255, 0.12);
    --control-shadow: rgba(16, 15, 14, 0.18);
    --control-ink: rgba(255, 255, 255, 0.9);
    --control-ink-muted: rgba(255, 255, 255, 0.58);
    --control-glass-top: rgba(255, 255, 255, 0.22);
    --control-glass-bottom: rgba(20, 20, 22, 0.5);
    --control-glass-edge: rgba(255, 255, 255, 0.3);
    --control-glass-shine: rgba(255, 255, 255, 0.42);
    --control-glass-depth: rgba(0, 0, 0, 0.24);
    --selected-surface: rgba(247, 247, 249, 0.96);
    --selected-ink: rgba(15, 15, 17, 0.96);
    --focus-ring: rgba(0, 122, 255, 0.74);
  }

  html[data-background="cutting"] {
    --page-background-color: #063826;
    --page-background-image:
      linear-gradient(180deg, rgba(1, 16, 11, 0.16), rgba(1, 16, 11, 0.28)),
      url("/images/background-cutting-mat.svg");
    --page-background-size: cover, cover;
    --page-background-position: center, center;
    --page-background-repeat: no-repeat, no-repeat;
    --control-surface: rgba(246, 248, 246, 0.54);
    --control-border: rgba(255, 255, 255, 0.48);
    --control-shadow: rgba(0, 14, 9, 0.26);
    --control-ink: rgba(12, 22, 17, 0.92);
    --control-ink-muted: rgba(10, 19, 15, 0.6);
    --control-glass-top: rgba(255, 255, 255, 0.66);
    --control-glass-bottom: rgba(206, 232, 218, 0.34);
    --control-glass-edge: rgba(255, 255, 255, 0.68);
    --control-glass-shine: rgba(255, 255, 255, 0.82);
    --control-glass-depth: rgba(0, 27, 18, 0.24);
    --selected-surface: rgba(248, 250, 248, 0.94);
    --selected-ink: rgba(8, 17, 13, 0.96);
    --focus-ring: rgba(245, 255, 251, 0.84);
  }

  html[data-background="blueprint"] {
    --page-background-color: #0a3d66;
    --page-background-image:
      linear-gradient(180deg, rgba(2, 13, 27, 0.1), rgba(2, 13, 27, 0.22)),
      url("/images/background-blueprint.svg");
    --page-background-size: cover, cover;
    --page-background-position: center, center;
    --page-background-repeat: no-repeat, no-repeat;
    --control-surface: rgba(246, 248, 252, 0.54);
    --control-border: rgba(255, 255, 255, 0.48);
    --control-shadow: rgba(0, 12, 25, 0.26);
    --control-ink: rgba(8, 15, 24, 0.9);
    --control-ink-muted: rgba(9, 16, 24, 0.58);
    --control-glass-top: rgba(255, 255, 255, 0.68);
    --control-glass-bottom: rgba(208, 222, 238, 0.34);
    --control-glass-edge: rgba(255, 255, 255, 0.7);
    --control-glass-shine: rgba(255, 255, 255, 0.84);
    --control-glass-depth: rgba(0, 24, 52, 0.24);
    --selected-surface: rgba(248, 250, 255, 0.94);
    --selected-ink: rgba(6, 12, 22, 0.96);
    --focus-ring: rgba(242, 249, 255, 0.86);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    min-height: 100%;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  body {
    min-height: 100%;
    margin: 0;
    color: var(--ink);
  }

  html,
  body {
    background-color: var(--page-background-color);
    background-image: var(--page-background-image);
    background-position: var(--page-background-position);
    background-repeat: var(--page-background-repeat);
    background-size: var(--page-background-size);
  }

  a {
    color: inherit;
  }

  .page {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    overflow-x: hidden;
    isolation: isolate;
    width: 100%;
    padding:
      calc(env(safe-area-inset-top) + 1.25rem)
      calc(env(safe-area-inset-right) + clamp(1rem, 4vw, 3.5rem))
      calc(env(safe-area-inset-bottom) + 1.25rem)
      calc(env(safe-area-inset-left) + clamp(1rem, 4vw, 3.5rem));
    background-color: var(--page-background-color);
    background-image: var(--page-background-image);
    background-position: var(--page-background-position);
    background-repeat: var(--page-background-repeat);
    background-size: var(--page-background-size);
    transition: background-color 220ms ease;
  }

  .composition {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    align-content: center;
    width: min(100%, 42rem);
    min-height: clamp(20rem, 58svh, 32rem);
    padding:
      clamp(3.8rem, 11vh, 5.8rem)
      clamp(0.75rem, 4vw, 2.4rem)
      clamp(4.4rem, 12vh, 6rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .name-tape-image {
    position: absolute;
    top: calc(env(safe-area-inset-top) + 0.8rem);
    left: 50%;
    z-index: 3;
    display: block;
    width: clamp(12rem, 24vw, 20rem);
    max-width: 76vw;
    height: auto;
    filter:
      drop-shadow(0 0.15rem 0.08rem rgba(42, 31, 18, 0.12))
      drop-shadow(0.18rem 0.28rem 0.28rem rgba(42, 31, 18, 0.08));
    transform: translateX(-50%) rotate(-2.8deg);
    user-select: none;
    -webkit-user-drag: none;
  }

  .post-it-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: max-content;
    max-width: 100%;
  }

  .post-it-wrap::before {
    content: none;
  }

  .post-it-image {
    z-index: 1;
    display: block;
    width: clamp(13rem, 26vw, 18.5rem);
    max-width: 100%;
    height: auto;
    filter: none;
    transform: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .socials::before,
  .socials::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
  }
  .socials::before {
    background:
      radial-gradient(circle at 22% 16%, var(--control-glass-shine), transparent 32%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.32), transparent 44%),
      linear-gradient(90deg, rgba(255, 255, 255, 0.14), transparent 18%, transparent 82%, rgba(255, 255, 255, 0.12));
    opacity: 0.76;
  }
  .socials::after {
    inset: 1px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background:
      linear-gradient(135deg, transparent 0 42%, rgba(255, 255, 255, 0.28) 48%, transparent 56%),
      radial-gradient(ellipse at 50% 100%, rgba(255, 255, 255, 0.16), transparent 58%);
    opacity: 0.68;
  }

  .liquid-glass-layer {
    position: absolute;
    z-index: 0;
    display: block;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .liquid-glass-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    pointer-events: none;
  }
  html[data-liquid-glass="active"] .socials {
    border-color: transparent;
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
    overflow: visible;
  }

  html[data-liquid-glass="active"] .liquid-glass-layer {
    opacity: 1;
  }

  .socials {
    position: fixed;
    right: calc(env(safe-area-inset-right) + 1rem);
    bottom: calc(env(safe-area-inset-bottom) + 1rem);
    z-index: 3;
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.18rem;
    width: auto;
    padding: 0.3rem;
    border: 1px solid var(--control-border);
    border-radius: 2rem;
    background:
      linear-gradient(145deg, var(--control-glass-top), var(--control-surface) 48%, var(--control-glass-bottom)),
      var(--control-surface);
    -webkit-backdrop-filter: blur(34px) saturate(1.55) brightness(1.08);
    backdrop-filter: blur(34px) saturate(1.55) brightness(1.08);
    box-shadow:
      0 1.25rem 2.7rem var(--control-shadow),
      0 0.22rem 0.5rem rgba(0, 0, 0, 0.08),
      inset 0 1px 0 var(--control-glass-edge),
      inset 0 -0.9rem 1.4rem var(--control-glass-depth);
    isolation: isolate;
    overflow: hidden;
  }

  .social-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.8rem;
    min-height: 2.8rem;
    padding: 0.72rem;
    border: 0;
    border-radius: 1.55rem;
    color: var(--control-ink);
    background: transparent;
    text-decoration: none;
    box-shadow: none;
    transition:
      color 150ms ease,
      opacity 150ms ease,
      transform 150ms ease;
  }
  html[data-liquid-glass="active"] .social-link {
    z-index: 2;
  }
  html[data-liquid-glass="active"] .socials::before,
  html[data-liquid-glass="active"] .socials::after {
    content: none;
  }

  .social-link::before,
  .social-link::after {
    content: none;
  }

  .social-link:hover {
    opacity: 0.82;
    transform: scale(1.06);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .social-link svg {
    position: relative;
    z-index: 1;
    width: 1.16rem;
    height: 1.16rem;
    flex: 0 0 auto;
    fill: currentColor;
  }

  .social-link span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (max-width: 720px) {
    .page {
      padding-inline:
        calc(env(safe-area-inset-left) + clamp(0.8rem, 4vw, 1.25rem))
        calc(env(safe-area-inset-right) + clamp(0.8rem, 4vw, 1.25rem));
    }

    html[data-background="paper"] .page {
      background-size: 36px 36px;
    }

    .composition {
      width: 100%;
      min-height: min(65svh, 30rem);
      padding:
        clamp(3.5rem, 10vh, 4.8rem)
        0.5rem
        clamp(4.8rem, 12vh, 6rem);
    }

    .name-tape-image {
      width: min(68vw, 16rem);
    }

    .post-it-image {
      width: min(68vw, 17.25rem);
    }

    .socials {
      right: calc(env(safe-area-inset-right) + 0.82rem);
      bottom: calc(env(safe-area-inset-bottom) + 0.82rem);
      gap: 0.24rem;
      padding: 0.32rem;
    }

    .social-link {
      padding: 0.72rem;
    }
  }

  @media (max-width: 360px) {
    .name-tape-image {
      width: min(64vw, 14rem);
    }

    .post-it-image {
      width: min(68vw, 15.4rem);
    }

    .social-link {
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0.64rem 0.68rem;
    }

  }

  @media (max-height: 650px) {
    .composition {
      min-height: min(54svh, 22rem);
      padding-block: clamp(2.8rem, 10vh, 4rem) clamp(4rem, 14vh, 5rem);
    }

    .name-tape-image {
      width: min(32vw, 15rem);
    }

    .post-it-image {
      width: min(34vw, 14rem);
    }
  }
</style>
