---
const pageTitle = "Matthieu Babe - Site en construction";
const pageDescription =
  "Le nouveau site de Matthieu Babe est en préparation. Une présence plus simple, plus rapide et plus personnelle arrive bientôt.";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f6f1e7" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://matthieubabe.fr" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="site-shell">
      <section class="hero" aria-labelledby="page-title">
        <img
          class="hero-media"
          src="/images/work-in-progress.png"
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="hero-overlay"></div>

        <header class="site-header" aria-label="Identité du site">
          <a class="brand" href="/" aria-label="Matthieu Babe">
            <span class="brand-mark" aria-hidden="true">MB</span>
            <span>matthieubabe.fr</span>
          </a>
        </header>

        <div class="hero-content">
          <p class="eyebrow">Nouveau site</p>
          <h1 id="page-title">Matthieu Babe</h1>
          <p class="intro">
            Le site se reconstruit en version plus simple, plus rapide et plus
            personnelle.
          </p>
        </div>
      </section>

      <section class="status" aria-label="État du site">
        <div>
          <p class="status-label">En construction</p>
          <h2>Une première version arrive bientôt.</h2>
        </div>
        <p>
          Le domaine reste le même. La nouvelle base technique est pensée pour
          évoluer tranquillement, sans dépendre d’un constructeur de pages.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --ink: #191510;
    --muted: #625b52;
    --paper: #f6f1e7;
    --paper-strong: #fffaf0;
    --line: rgba(25, 21, 16, 0.14);
    --accent: #1f6f5b;
    --accent-warm: #b35f2d;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
  }

  a {
    color: inherit;
  }

  .site-shell {
    min-height: 100svh;
    background: var(--paper);
  }

  .hero {
    position: relative;
    display: grid;
    min-height: 76svh;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(1rem, 2vw, 2rem);
  }

  .hero-media,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media {
    z-index: -2;
    object-fit: cover;
  }

  .hero-overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(246, 241, 231, 0.96), rgba(246, 241, 231, 0.72) 48%, rgba(246, 241, 231, 0.2)),
      linear-gradient(0deg, rgba(246, 241, 231, 0.92), rgba(246, 241, 231, 0) 34%);
  }

  .site-header {
    align-self: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: max-content;
    max-width: 100%;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .brand-mark {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    background: rgba(255, 250, 240, 0.72);
    font-size: 0.82rem;
    border-radius: 8px;
  }

  .hero-content {
    align-self: end;
    width: min(100%, 48rem);
    padding-block: clamp(4rem, 14vh, 8rem) clamp(2rem, 5vh, 4rem);
  }

  .eyebrow,
  .status-label {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1.25rem;
    max-width: 11ch;
    font-size: clamp(4.2rem, 13vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .intro {
    max-width: 34rem;
    margin-bottom: 0;
    color: #322a21;
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    line-height: 1.28;
  }

  .status {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 32rem);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    max-width: 74rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .status h2 {
    margin-bottom: 0;
    max-width: 13ch;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.98;
  }

  .status p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 78svh;
    }

    .hero-overlay {
      background:
        linear-gradient(180deg, rgba(246, 241, 231, 0.96), rgba(246, 241, 231, 0.62) 54%, rgba(246, 241, 231, 0.94)),
        linear-gradient(90deg, rgba(246, 241, 231, 0.9), rgba(246, 241, 231, 0.1));
    }

    .brand {
      font-size: 0.88rem;
    }

    .hero-content {
      padding-top: 7rem;
    }

    h1 {
      max-width: 7ch;
    }

    .status {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .status h2 {
      max-width: 12ch;
    }
  }
</style>
