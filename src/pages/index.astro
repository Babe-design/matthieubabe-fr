---
const pageTitle = "Matthieu Babe";
const pageDescription =
  "Matthieu Babe is reworking this place. A quieter, more personal site is coming soon.";
const siteUrl = "https://matthieubabe.fr";
const socialImage = `${siteUrl}/social/og-image.png`;

const socialLinks = [
  {
    name: "X",
    href: "https://x.com/BabeMatthieu",
    icon: "x"
  },
  {
    name: "Threads",
    href: "https://www.threads.com/@matthieubabe",
    icon: "threads"
  },
  {
    name: "Dribbble",
    href: "https://dribbble.com/matthieubabe",
    icon: "dribbble"
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/matthieubabe",
    icon: "linkedin"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Handwritten Matthieu Babe label on dotted paper" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Handwritten Matthieu Babe label on dotted paper" />

    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="page" aria-labelledby="page-title">
      <section class="composition">
        <h1 id="page-title" class="sr-only">Matthieu Babe</h1>
        <img
          class="post-it-image"
          src="/images/post-it-reworking.png"
          alt="I'm reworking this place"
          width="1000"
          height="1000"
          loading="eager"
          decoding="async"
          draggable="false"
        />
      </section>

      <nav class="socials" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              class={`social-link social-link-${link.icon}`}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.name} profile`}
              title={link.name}
            >
              {link.icon === "x" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.7 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.3-5.6 6.3H2.1l7.3-8.3L1.8 3h6.4l4.4 5.7L17.7 3Zm-1.1 16.2h1.7L7.3 4.7H5.4l11.2 14.5Z" />
                </svg>
              )}
              {link.icon === "threads" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.1 2.1c3.2 0 5.8 1.4 7.3 4l-1.9 1.3c-1.2-2-3-3-5.4-3-3.7 0-6.3 3-6.3 7.6s2.6 7.6 6.4 7.6c3.3 0 5.9-2 5.9-4.6 0-1.5-.8-2.5-2.3-3.1-.4 3-2.1 4.7-4.7 4.7-2.2 0-3.8-1.3-3.8-3.2 0-2.1 1.8-3.4 4.7-3.4.5 0 1 0 1.5.1-.3-1.7-1.2-2.6-2.8-2.6-1.2 0-2.2.4-3.2 1.2L6.4 6.9c1.2-1 2.7-1.5 4.3-1.5 3 0 4.8 1.8 5.2 5.2 2.8.8 4.4 2.4 4.4 4.5 0 3.8-3.4 6.6-8.1 6.6-5.2 0-8.7-3.9-8.7-9.8s3.5-9.8 8.6-9.8Zm-.8 12.4c1.3 0 2.1-.8 2.3-2.4-.6-.1-1.1-.2-1.6-.2-1.6 0-2.5.5-2.5 1.4 0 .7.7 1.2 1.8 1.2Z" />
                </svg>
              )}
              {link.icon === "dribbble" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.2a9.8 9.8 0 1 0 0 19.6 9.8 9.8 0 0 0 0-19.6Zm6.4 4.5a7.8 7.8 0 0 1 1.7 4.8c-1.8-.4-3.5-.4-5.1-.1-.2-.5-.4-1-.7-1.5 1.6-.7 2.9-1.8 4.1-3.2ZM12 4.1c1.9 0 3.6.7 4.9 1.8-1 1.2-2.2 2-3.6 2.6-1-1.8-2-3.2-2.7-4.3.5-.1.9-.1 1.4-.1Zm-3.5.8c.8 1.1 1.8 2.5 2.8 4.2-1.9.6-4.1.8-6.6.8.6-2.3 2-4.1 3.8-5Zm-4.4 7V12c0-.1 0-.2.1-.3 3 0 5.7-.3 8-1 .2.4.4.8.6 1.3-3.2 1-5.7 2.9-7.4 5.6a7.8 7.8 0 0 1-1.3-5.7Zm8 8a7.6 7.6 0 0 1-5.2-2.1c1.5-2.5 3.7-4.1 6.5-5 .8 2.2 1.4 4.4 1.7 6.5-1 .4-2 .6-3 .6Zm4.8-1.6a27.5 27.5 0 0 0-1.6-5.9c1.5-.2 3.1-.1 4.8.3a7.8 7.8 0 0 1-3.2 5.6Z" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5.2 8.9h3.3V20H5.2V8.9Zm1.7-5.4c1.1 0 1.9.7 1.9 1.7S8 7 6.9 7 5 6.3 5 5.3s.8-1.8 1.9-1.8ZM10.7 8.9h3.1v1.5h.1c.4-.8 1.5-1.8 3.1-1.8 3.3 0 3.9 2.2 3.9 5V20h-3.3v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V20h-3.3V8.9Z" />
                </svg>
              )}
              <span>{link.name}</span>
            </a>
          ))
        }
      </nav>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --dot: rgba(39, 39, 37, 0.16);
    --ink: #1c1a17;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    min-height: 100%;
    background: var(--paper);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  body {
    min-height: 100%;
    margin: 0;
    color: var(--ink);
    background: var(--paper);
  }

  a {
    color: inherit;
  }

  .page {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    overflow-x: hidden;
    isolation: isolate;
    padding:
      max(1.25rem, env(safe-area-inset-top))
      clamp(1rem, 4vw, 3.5rem)
      max(1.25rem, env(safe-area-inset-bottom));
    background:
      radial-gradient(circle at center, var(--dot) 0 1.45px, transparent 1.6px) 0 0 / 42px 42px,
      var(--paper);
  }

  .composition {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    align-self: center;
    justify-self: center;
    width: min(100%, 42rem);
    min-height: clamp(19rem, 54svh, 29rem);
    padding: clamp(1rem, 4vw, 2.4rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .post-it-image {
    z-index: 1;
    display: block;
    width: clamp(16rem, 38vw, 25rem);
    max-width: 100%;
    height: auto;
    filter:
      drop-shadow(0 0.18rem 0.12rem rgba(42, 31, 18, 0.16))
      drop-shadow(0.22rem 0.38rem 0.28rem rgba(42, 31, 18, 0.12));
    user-select: none;
    -webkit-user-drag: none;
  }

  .socials {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(0.55rem, 1.5vw, 0.85rem);
    width: min(100%, 36rem);
    margin-inline: auto;
    padding-bottom: clamp(0.1rem, 1vh, 0.85rem);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 3rem;
    padding: 0.72rem;
    border: 1px solid rgba(28, 26, 23, 0.18);
    border-radius: 999px;
    color: var(--ink);
    background: rgba(255, 252, 241, 0.54);
    text-decoration: none;
    box-shadow: 0 0.38rem 0.8rem rgba(69, 55, 32, 0.08);
    transform: rotate(var(--tilt));
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .social-link:nth-child(1) {
    --tilt: -2deg;
  }

  .social-link:nth-child(2) {
    --tilt: 1.5deg;
  }

  .social-link:nth-child(3) {
    --tilt: -1deg;
  }

  .social-link:nth-child(4) {
    --tilt: 2deg;
  }

  .social-link:hover {
    background: rgba(255, 252, 241, 0.92);
    box-shadow: 0 0.58rem 1rem rgba(69, 55, 32, 0.13);
    transform: translateY(-2px) rotate(var(--tilt));
  }

  .social-link:focus-visible {
    outline: 3px solid rgba(28, 26, 23, 0.78);
    outline-offset: 4px;
  }

  .social-link svg {
    width: 1.16rem;
    height: 1.16rem;
    flex: 0 0 auto;
    fill: currentColor;
  }

  .social-link span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (max-width: 720px) {
    .page {
      grid-template-rows: minmax(0, 1fr) auto;
      padding-inline: clamp(0.8rem, 4vw, 1.25rem);
      background-size: 36px 36px, auto, auto;
    }

    .composition {
      width: 100%;
      min-height: min(64svh, 26rem);
      padding-inline: 0.5rem;
    }

    .post-it-image {
      width: min(84vw, 22rem);
    }

    .socials {
      max-width: 22rem;
      gap: 0.5rem;
    }

    .social-link {
      padding: 0.72rem;
    }
  }

  @media (max-width: 360px) {
    .post-it-image {
      width: min(84vw, 19rem);
    }

    .social-link {
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0.64rem 0.68rem;
    }

  }

  @media (max-height: 650px) {
    .composition {
      min-height: auto;
      padding-block: 0.75rem;
    }

    .post-it-image {
      width: min(62vw, 17rem);
    }
  }
</style>
