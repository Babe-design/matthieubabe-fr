---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";
import Identity from "../components/Identity.astro";
import "../styles/site.css";
interface Props { title?: string; description?: string; home?: boolean; }
const { home = false, title = site.name, description = "The personal space of Matthieu Babe. A few things, over time." } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="en" data-home={home ? "" : undefined} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <script is:inline src="/site-bootstrap.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-magnet-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-magnet-16.png" type="image/png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico?v=magnet" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-magnet.png" sizes="180x180" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social/og-image.png`} />
    <meta property="og:image:alt" content="I’m Matthieu. Babe. Design leader at Datadog." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/social/og-image.png`} />
    <meta name="twitter:image:alt" content="I’m Matthieu. Babe. Design leader at Datadog." />
    <link rel="preload" as="font" href="/fonts/allo-variable.woff2" type="font/woff2" crossorigin="anonymous" />
    <Analytics />
  </head>
  <body class:list={{ "is-home": home }}>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <Identity />
      <slot />
    </div>
    <script>
      import "../scripts/site-entrance";
    </script>
    <SpeedInsights />
  </body>
</html>
