---
import SiteLayout from "./SiteLayout.astro";
import { site } from "../data/site";
interface Props { section: "work" | "experiment" | "about"; }
const { section } = Astro.props;
const title = section === "work" ? site.name : `${section === "experiment" ? "Experiment" : "About"} — ${site.name}`;
const panelAnimation = {
  old: { name: "portfolio-out", duration: "180ms", easing: "var(--ease-out)", fillMode: "both" },
  new: { name: "portfolio-in", duration: "1ms", easing: "var(--ease-out)", fillMode: "both" }
};
---
<SiteLayout home title={title} description={`${site.intro} at ${site.company.name}. ${site.about[0]}`}>
  <div class="portfolio-head" transition:name="portfolio-heading" transition:animate="none">
    <nav class="portfolio-nav" aria-label="Portfolio sections">
      <a href="/" data-section-link aria-current={section === "work" ? "page" : undefined}>Work</a>
      <a href="/experiment/" data-section-link aria-current={section === "experiment" ? "page" : undefined}>Experiment</a>
      <a href="/about/" data-section-link aria-current={section === "about" ? "page" : undefined}>About</a>
    </nav>
  </div>
  <main id="content" class="portfolio-content" data-intro-reveal transition:name="portfolio-panel" transition:animate={{ forwards: panelAnimation, backwards: panelAnimation }}>
    <h1 class="sr-only">{section === "about" ? "About Matthieu Babe" : `Matthieu Babe — ${section === "experiment" ? "Experiment" : "Work"}`}</h1>
    <slot />
  </main>
<script>
  import "../scripts/portfolio-nav";

  let restoreSectionFocus = false;
  document.addEventListener("astro:before-preparation", event => {
    restoreSectionFocus = !!event.sourceElement?.matches("[data-section-link]:focus-visible") && event.sourceElement === document.activeElement;
  });
  document.addEventListener("astro:page-load", () => {
    if (restoreSectionFocus) document.querySelector<HTMLElement>(".portfolio-nav [aria-current=page]")?.focus({ preventScroll: true });
    restoreSectionFocus = false;
  });
</script>
</SiteLayout>
