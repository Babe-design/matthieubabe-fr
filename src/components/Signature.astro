---
import ChangelogEntries from "./ChangelogEntries.astro";
import { site, changelog } from "../data/site";
interface Props { variant?: "default" | "about"; }
const { variant = "default" } = Astro.props;
const latest = changelog[0].date;
const dateLabel = latest.slice(0, 10);
const formatted = new Intl.DateTimeFormat("en", {dateStyle:"long", timeStyle:"short", timeZone:"UTC"}).format(new Date(latest));
---
<footer class:list={["signature", { "signature-about": variant === "about" }]}>
  {variant === "about" ? <div class="connect">
    <h2 class="section-label">Connect</h2>
    <ul class="connect-links">
      {site.links.map(link => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a></li>)}
      {site.email && <li><a href={`mailto:${site.email}`}>Email</a></li>}
    </ul>
  </div> : <p class="signature-links">
    Reach me on{ " " }
    {site.links.map((link, i) => <><a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a>{i < site.links.length - 1 ? ", " : ""}</>)}
    {site.email && <> or <a href={`mailto:${site.email}`}>email</a></>}
  </p>}
  {variant === "about" && <h2 class="section-label colophon-label">Colophon</h2>}
  {variant === "about" && <p class="colophon-note">{site.colophon}</p>}
  {variant === "about" && <p class="colophon-note colophon-credit">Set in <a href="https://allo.joshpuckett.me/" target="_blank" rel="noopener noreferrer">Allo</a>, designed by <a href="https://x.com/joshpuckett" target="_blank" rel="noopener noreferrer">Josh Puckett</a>.</p>}
  <p class="last-updated">
    <a href="/changelog/" data-open-changelog aria-describedby="changelog-link-help">Last updated <time datetime={latest} data-updated-at={latest} title={`${formatted} UTC`}>{dateLabel}</time><span data-ago hidden> ago</span></a>
  </p>
  <span id="changelog-link-help" class="sr-only">View changelog</span>
</footer>
<dialog class="changelog-sheet" aria-labelledby="changelog-heading">
  <div class="sheet-heading">
    <h2 id="changelog-heading">Changelog</h2>
    <button class="sheet-close" type="button" autofocus>Close</button>
  </div>
  <div class="sheet-content">
    <ChangelogEntries />
  </div>
</dialog>
<script>
  function initSignature() {
    const controller = new AbortController();
    const { signal } = controller;
    const sheet = document.querySelector<HTMLDialogElement>(".changelog-sheet");
    const trigger = document.querySelector<HTMLAnchorElement>("[data-open-changelog]");
    if (sheet && trigger) {
      trigger.setAttribute("aria-haspopup", "dialog");
      let closing = false;
      const close = async () => {
        if (closing || !sheet.open) return;
        closing = true;
        sheet.classList.add("is-closing");
        await Promise.allSettled(sheet.getAnimations().map(animation => animation.finished));
        sheet.close();
        sheet.classList.remove("is-closing");
        closing = false;
      };
      trigger.addEventListener("click", event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        sheet.showModal();
      }, { signal });
      sheet.querySelector(".sheet-close")?.addEventListener("click", () => void close(), { signal });
      sheet.addEventListener("cancel", event => { event.preventDefault(); void close(); }, { signal });
      sheet.addEventListener("click", event => {
        if (event.target !== sheet) return;
        const rect = sheet.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) void close();
      }, { signal });
    }

    const timer = document.querySelector<HTMLTimeElement>("[data-updated-at]");
    if (timer) {
      const updatedAt = Date.parse(timer.dataset.updatedAt!);
      let updateTimeout: number;
      const tick = () => {
        window.clearTimeout(updateTimeout);
        const elapsed = Math.max(0, Date.now() - updatedAt);
        const totalMinutes = Math.floor(elapsed / 60_000);
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;
        timer.textContent = `${days ? `${days}d ` : ""}${hours}h ${minutes}m`;
        document.querySelector<HTMLElement>("[data-ago]")?.removeAttribute("hidden");
        updateTimeout = window.setTimeout(tick, 60_000 - (elapsed % 60_000));
      };
      tick();
      const cleanup = () => { window.clearTimeout(updateTimeout); controller.abort(); };
      window.addEventListener("pagehide", () => window.clearTimeout(updateTimeout), { signal });
      window.addEventListener("pageshow", event => { if (event.persisted) tick(); }, { signal });
      document.addEventListener("visibilitychange", () => { if (!document.hidden) tick(); }, { signal });
      document.addEventListener("astro:before-swap", cleanup, { once: true, signal });
    }
  }
  document.addEventListener("astro:page-load", initSignature);
</script>
