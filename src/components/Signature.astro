---
import ChangelogEntries from "./ChangelogEntries.astro";
import { site, changelog } from "../data/site";
const latest = changelog[0].date;
const formatted = new Intl.DateTimeFormat("en", {dateStyle:"long", timeStyle:"short", timeZone:"UTC"}).format(new Date(latest));
---
<footer class="signature">
  <p class="signature-links">
    Reach me on{ " " }
    {site.links.map((link, i) => <><a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a>{i < site.links.length - 1 ? ", " : ""}</>)}
    {site.email && <> or <a href={`mailto:${site.email}`}>email</a></>}
  </p>
  <p class="last-updated">
    Last updated <time datetime={latest} data-updated-at={latest} title={`${formatted} UTC`}>{formatted} UTC</time><span data-ago hidden> ago</span>
  </p>
  <p class="changelog-link">Visit the <a href="/changelog/" data-open-changelog>changelog</a>.</p>
</footer>
<dialog class="changelog-sheet" aria-labelledby="changelog-heading">
  <div class="sheet-heading">
    <h2 id="changelog-heading">Changelog</h2>
    <button class="sheet-close" type="button" autofocus>Close</button>
  </div>
  <div class="sheet-content">
    <ChangelogEntries />
  </div>
</dialog>
<script>
  const sheet = document.querySelector<HTMLDialogElement>(".changelog-sheet");
  const trigger = document.querySelector<HTMLAnchorElement>("[data-open-changelog]");
  if (sheet && trigger) {
    let closing = false;
    const close = async () => {
      if (closing || !sheet.open) return;
      closing = true;
      sheet.classList.add("is-closing");
      await Promise.allSettled(sheet.getAnimations().map(animation => animation.finished));
      sheet.close();
      sheet.classList.remove("is-closing");
      closing = false;
    };
    trigger.addEventListener("click", event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      sheet.showModal();
    });
    sheet.querySelector(".sheet-close")?.addEventListener("click", () => void close());
    sheet.addEventListener("cancel", event => { event.preventDefault(); void close(); });
    sheet.addEventListener("click", event => {
      if (event.target !== sheet) return;
      const rect = sheet.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) void close();
    });
  }

  const timer = document.querySelector<HTMLTimeElement>("[data-updated-at]");
  if (timer) {
    const updatedAt = Date.parse(timer.dataset.updatedAt!);
    const tick = () => {
      const elapsed = Math.max(0, Math.floor((Date.now() - updatedAt) / 1000));
      const days = Math.floor(elapsed / 86400);
      const hours = Math.floor((elapsed % 86400) / 3600);
      const minutes = Math.floor((elapsed % 3600) / 60);
      const seconds = elapsed % 60;
      timer.textContent = `${days ? `${days}d ` : ""}${hours}h ${minutes}m ${seconds}s`;
      document.querySelector<HTMLElement>("[data-ago]")?.removeAttribute("hidden");
    };
    tick();
    const interval = window.setInterval(tick, 1000);
    window.addEventListener("pagehide", () => window.clearInterval(interval), { once: true });
  }
</script>
