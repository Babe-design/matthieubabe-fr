<div class="experiment-frame">
  <gummy-playground class="experiment-surface gummy-stage">
    <div class="gummy-object" data-gummy-object>
      <div class="gummy-material" data-gummy-material>
        <img data-gummy-art src="/images/identity/b-yellow-gel.webp" alt="A yellow gummy letter b" width="320" height="360" decoding="async" draggable="false" />
        <canvas hidden aria-hidden="true"></canvas>
      </div>
      <button class="gummy-handle" data-gummy-handle type="button" aria-label="Stretch the gummy b" aria-describedby="gummy-instructions" hidden></button>
    </div>
    <p id="gummy-instructions" class="sr-only">Drag and release the letter. Use the arrow keys to pull it, Space or Enter to bounce it, and Escape to reset it.</p>
  </gummy-playground>
</div>

<style>
  .gummy-stage {
    display: grid;
    place-items: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 12px;
  }

  .gummy-object {
    position: absolute;
    top: calc(50% - 6px);
    left: 50%;
    height: min(73%, 284px);
    aspect-ratio: 8 / 9;
    translate: -50% -50%;
  }

  .gummy-material {
    position: absolute;
    inset: 0;
    transform-origin: 50% 62%;
    filter: drop-shadow(0 2px 2px rgb(143 87 8 / .14)) drop-shadow(0 6px 7px rgb(143 87 8 / .06));
    pointer-events: none;
  }

  .gummy-material img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-select: none;
  }

  .gummy-material canvas {
    position: absolute;
    inset: -16%;
    width: 132%;
    height: 132%;
    visibility: hidden;
  }

  .gummy-stage[data-deforming] canvas { display: block; visibility: visible; }
  .gummy-stage[data-deforming] img { visibility: hidden; }

  .gummy-handle {
    position: absolute;
    inset: 9% 12% 10% 18%;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 24px;
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  .gummy-stage[data-dragging], .gummy-stage[data-dragging] .gummy-handle { cursor: grabbing; }
  .gummy-handle:focus { outline: none; }
  .gummy-handle:focus-visible:not([data-pointer-focus]) { outline: 2px solid var(--ink); outline-offset: 5px; }
</style>

<script>
  import "../scripts/gummy-playground";
</script>
