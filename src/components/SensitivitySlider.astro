<div class="experiment-frame">
  <div class="experiment-surface sensitivity-stage">
    <sensitivity-slider class="sensitivity-control">
      <div class="sensitivity-rail" aria-hidden="true"></div>
      <div class="sensitivity-marks" aria-hidden="true">
        {Array.from({ length: 5 }, () => <span class="sensitivity-mark" data-sensitivity-mark></span>)}
      </div>
      <input
        class="sensitivity-range"
        type="range"
        min="0"
        max="100"
        step="1"
        value="70"
        aria-label="Sensitivity"
      />
    </sensitivity-slider>
  </div>
</div>

<style>
  .sensitivity-stage {
    display: grid;
    place-items: center;
    padding-inline: clamp(18px, 6vw, 42px);
    border-radius: 12px;
    background:
      repeating-linear-gradient(0deg, rgb(42 65 108 / .022) 0 1px, transparent 1px 4px),
      radial-gradient(ellipse at 4% 8%, #daeef8, transparent 66%),
      radial-gradient(ellipse at 100% 100%, #eae2f8, transparent 65%),
      #f5f7fc;
    box-shadow: inset 0 0 0 1px rgb(57 76 120 / .065);
  }

  .sensitivity-control {
    display: block;
    position: relative;
    width: min(100%, 360px);
    --rail-height: 20px;
    --thumb-size: 26px;
    --mark-size: 4px;
    --thumb-shadow: 0 1px 4px rgb(41 44 66 / .26), 0 0 0 1px rgb(41 44 66 / .15);
    --thumb-motion: 150ms cubic-bezier(.2,.75,.3,1.2);
  }

  .sensitivity-rail, .sensitivity-marks {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .sensitivity-rail {
    inset-inline: 0;
    height: var(--rail-height);
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / .22), transparent 70%),
      linear-gradient(90deg, #25ac79, #86cc64 26%, #edca58 51%, #f3995b 74%, #e5595e);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / .4),
      inset 0 -1px 2px rgb(74 43 49 / .2),
      0 4px 14px rgb(63 67 102 / .13);
  }

  .sensitivity-marks {
    display: flex;
    justify-content: space-between;
    inset-inline: calc((var(--thumb-size) - var(--mark-size)) / 2);
  }

  .sensitivity-mark {
    width: var(--mark-size);
    height: var(--mark-size);
    border-radius: 50%;
    background: #fff;
    opacity: .78;
    transition: transform var(--thumb-motion), opacity var(--thumb-motion);
  }

  .sensitivity-mark[data-hovered] { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .sensitivity-mark[data-hovered] { transform: scale(1.75); }
  }

  .sensitivity-range {
    display: block;
    position: relative;
    appearance: none;
    width: 100%;
    height: 44px;
    margin: 0;
    background: transparent;
    cursor: grab;
  }

  .sensitivity-range:active { cursor: grabbing; }

  .sensitivity-range:focus-visible {
    outline: 2px solid #335d4b;
    border-radius: 8px;
    outline-offset: 2px;
  }

  .sensitivity-range::-webkit-slider-runnable-track {
    height: var(--rail-height);
    background: transparent;
  }

  .sensitivity-range::-moz-range-track {
    height: var(--rail-height);
    background: transparent;
  }

  .sensitivity-range::-webkit-slider-thumb {
    appearance: none;
    width: var(--thumb-size);
    height: var(--thumb-size);
    margin-top: calc((var(--rail-height) - var(--thumb-size)) / 2);
    border-radius: 50%;
    border: 0;
    background: #fff;
    box-shadow: var(--thumb-shadow);
    transition: transform var(--thumb-motion);
  }

  .sensitivity-range::-moz-range-thumb {
    width: var(--thumb-size);
    height: var(--thumb-size);
    border-radius: 50%;
    border: 0;
    background: #fff;
    box-shadow: var(--thumb-shadow);
    transition: transform var(--thumb-motion);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .sensitivity-range:hover::-webkit-slider-thumb { transform: scale(1.09); }
    .sensitivity-range:hover::-moz-range-thumb { transform: scale(1.09); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sensitivity-range:active::-webkit-slider-thumb { transform: scale(1.18); }
    .sensitivity-range:active::-moz-range-thumb { transform: scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sensitivity-control { --thumb-motion: 0ms; }
  }

  @media (forced-colors: active) {
    .sensitivity-range { appearance: auto; }
    .sensitivity-rail, .sensitivity-marks { visibility: hidden; }
  }
</style>

<script>
  class SensitivitySlider extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector("input");
      if (!input) return;

      const update = () => {
        // Moving right lowers the threshold and makes detection more aggressive.
        const threshold = 100 - input.valueAsNumber;
        const level = threshold < 25 ? "Aggressive"
          : threshold < 50 ? "Moderate"
          : threshold === 50 ? "Balanced"
          : threshold < 75 ? "Lenient"
          : "Very lenient";
        input.setAttribute("aria-valuetext", level + ", " + threshold + "% minimum confidence");
      };

      input.oninput = update;
      update();

      // The decorations sit below the native control, which owns the whole drag target.
      const marks = [...this.querySelectorAll<HTMLElement>("[data-sensitivity-mark]")];
      let hovered: HTMLElement | undefined;
      const highlight = (mark?: HTMLElement) => {
        if (mark === hovered) return;
        hovered?.removeAttribute("data-hovered");
        mark?.setAttribute("data-hovered", "");
        hovered = mark;
      };

      input.onpointermove = event => {
        if (event.pointerType === "touch" || event.buttons !== 0) {
          highlight();
          return;
        }
        highlight(marks.find(mark => {
          const rect = mark.getBoundingClientRect();
          return Math.hypot(event.clientX - rect.left - rect.width / 2, event.clientY - rect.top - rect.height / 2) <= 11;
        }));
      };
      input.onpointerleave = () => highlight();
      input.onpointerdown = () => highlight();
    }
  }

  if (!customElements.get("sensitivity-slider")) customElements.define("sensitivity-slider", SensitivitySlider);
</script>
