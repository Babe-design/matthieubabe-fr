<div class="experiment-frame">
  <div class="experiment-surface sensitivity-stage">
    <sensitivity-slider class="sensitivity-control">
      <div class="sensitivity-rail" aria-hidden="true"></div>
      <div class="sensitivity-marks" aria-hidden="true">
        {[0, 50, 100].map(value => <span class="sensitivity-mark" data-sensitivity-mark={value}></span>)}
      </div>
      <input
        class="sensitivity-range"
        type="range"
        min="0"
        max="100"
        step="1"
        value="70"
        aria-label="Sensitivity"
      />
    </sensitivity-slider>
  </div>
</div>

<style>
  .sensitivity-stage {
    display: grid;
    place-items: center;
    padding-inline: clamp(18px, 6vw, 42px);
    border-radius: 12px;
    background: #f5f5f5;
  }

  .sensitivity-control {
    display: block;
    position: relative;
    width: min(100%, 360px);
    --rail-height: 24px;
    --thumb-size: 30px;
    --mark-size: 4px;
    --thumb-shadow: 0 1px 4px rgb(41 44 66 / .24), 0 0 0 1px rgb(41 44 66 / .12);
    --thumb-motion: 150ms cubic-bezier(.2,.75,.3,1.2);
    --thumb-scale: 1;
  }

  .sensitivity-rail, .sensitivity-marks {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .sensitivity-rail {
    inset-inline: 0;
    height: var(--rail-height);
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / .13), transparent 68%),
      linear-gradient(90deg, #04bd71, #67d642 26%, #ffdb22 50%, #ff8a21 74%, #f22d49);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / .32),
      inset 0 -1px 2px rgb(74 43 49 / .16),
      0 4px 14px rgb(63 67 102 / .12);
  }

  .sensitivity-marks {
    display: flex;
    justify-content: space-between;
    inset-inline: calc((var(--thumb-size) - var(--mark-size)) / 2);
  }

  .sensitivity-mark {
    width: var(--mark-size);
    height: var(--mark-size);
    border-radius: 50%;
    background: #fff;
    opacity: .78;
    transition: transform var(--thumb-motion), opacity var(--thumb-motion);
  }

  .sensitivity-mark[data-hovered] { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .sensitivity-mark[data-hovered] { transform: scale(1.75); }
  }

  .sensitivity-range {
    display: block;
    position: relative;
    appearance: none;
    width: 100%;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    cursor: grab;
    -webkit-tap-highlight-color: transparent;
  }

  .sensitivity-range[data-hovered-mark] { cursor: pointer; }
  .sensitivity-range:active, .sensitivity-range[data-dragging] { cursor: grabbing; }
  .sensitivity-range[data-enhanced] { touch-action: none; }
  .sensitivity-range:focus-visible:not([data-pointer-focus]) {
    --thumb-shadow: 0 0 0 2px #fff, 0 0 0 4px #315de0;
  }

  .sensitivity-range::-webkit-slider-runnable-track {
    height: var(--rail-height);
    background: transparent;
  }

  .sensitivity-range::-moz-range-track {
    height: var(--rail-height);
    background: transparent;
  }

  .sensitivity-range::-webkit-slider-thumb {
    appearance: none;
    width: var(--thumb-size);
    height: var(--thumb-size);
    margin-top: calc((var(--rail-height) - var(--thumb-size)) / 2);
    border-radius: 50%;
    border: 0;
    background: #fff;
    box-shadow: var(--thumb-shadow);
    transform: scale(var(--thumb-scale));
    transition: transform var(--thumb-motion);
    animation: var(--thumb-settle, none);
  }

  .sensitivity-range::-moz-range-thumb {
    width: var(--thumb-size);
    height: var(--thumb-size);
    border-radius: 50%;
    border: 0;
    background: #fff;
    box-shadow: var(--thumb-shadow);
    transform: scale(var(--thumb-scale));
    transition: transform var(--thumb-motion);
    animation: var(--thumb-settle, none);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sensitivity-range[data-thumb-hovered] { --thumb-scale: 1.045; }
    .sensitivity-range[data-dragging] { --thumb-scale: 1.18; }
    .sensitivity-range[data-snapped] { --thumb-scale: 1.12; }
    .sensitivity-range[data-settling] { --thumb-settle: sensitivity-settle 180ms cubic-bezier(.18,.8,.26,1); }
  }

  @keyframes sensitivity-settle {
    from { translate: var(--thumb-offset) 0; }
    to { translate: 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sensitivity-control { --thumb-motion: 0ms; }
  }

  @media (forced-colors: active) {
    .sensitivity-range, .sensitivity-range[data-enhanced] { appearance: auto; touch-action: auto; }
    .sensitivity-range:focus-visible:not([data-pointer-focus]) { outline: 2px solid Highlight; outline-offset: 2px; }
    .sensitivity-rail, .sensitivity-marks { visibility: hidden; }
  }
</style>

<script>
  class SensitivitySlider extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector("input");
      if (!input) return;

      const update = () => {
        // Moving right lowers the threshold and makes detection more aggressive.
        const threshold = 100 - input.valueAsNumber;
        const level = threshold < 25 ? "Aggressive"
          : threshold < 50 ? "Moderate"
          : threshold === 50 ? "Balanced"
          : threshold < 75 ? "Lenient"
          : "Very lenient";
        input.setAttribute("aria-valuetext", level + ", " + threshold + "% minimum confidence");
      };

      input.oninput = update;
      update();

      const marks = Array.from(this.querySelectorAll<HTMLElement>("[data-sensitivity-mark]"), element => ({
        element,
        value: Number(element.dataset.sensitivityMark),
      }));
      if (marks.length < 2) return;

      const forcedColors = matchMedia("(forced-colors: active)");
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const magnetRadius = 19;
      const snapRadius = 5;
      const releaseRadius = 11;
      const settleRadius = 18;
      let drag: { id: number; offset: number; startValue: number; snapped?: number } | undefined;
      let hovered: HTMLElement | undefined;
      let settleTimer: number | undefined;

      const measure = () => {
        const first = marks[0].element.getBoundingClientRect();
        const last = marks[marks.length - 1].element.getBoundingClientRect();
        const left = first.left + first.width / 2;
        const width = last.left + last.width / 2 - left;
        const centerY = first.top + first.height / 2;
        const xAt = (value: number) => left + width * value / 100;
        return {
          left,
          width,
          centerY,
          radius: left - input.getBoundingClientRect().left,
          xAt,
          markAt: (x: number, y: number) => marks.find(({ value }) => Math.hypot(x - xAt(value), y - centerY) <= 12),
        };
      };

      const highlight = (mark?: HTMLElement) => {
        if (mark === hovered) return;
        hovered?.removeAttribute("data-hovered");
        mark?.setAttribute("data-hovered", "");
        hovered = mark;
        input.toggleAttribute("data-hovered-mark", !!mark);
      };

      const updateHover = (event: PointerEvent) => {
        const canHover = event.pointerType !== "touch" && !forcedColors.matches && event.buttons === 0;
        const { xAt, centerY, radius, markAt } = measure();
        const y = event.clientY - centerY;
        const onThumb = canHover && Math.hypot(event.clientX - xAt(input.valueAsNumber), y) <= radius + 1;
        input.toggleAttribute("data-thumb-hovered", onThumb);
        const mark = canHover && !onThumb ? markAt(event.clientX, event.clientY) : undefined;
        highlight(mark?.element);
      };

      const setValue = (value: number) => {
        const next = Math.round(Math.max(0, Math.min(100, value)));
        if (next === input.valueAsNumber) return;
        input.valueAsNumber = next;
        input.dispatchEvent(new Event("input", { bubbles: true, composed: true }));
      };

      const stopSettling = () => {
        window.clearTimeout(settleTimer);
        input.style.removeProperty("--thumb-offset");
        delete input.dataset.settling;
      };

      const settle = () => {
        const current = input.valueAsNumber;
        const nearest = marks.reduce((best, mark) => Math.abs(current - mark.value) < Math.abs(current - best.value) ? mark : best);
        const offset = (current - nearest.value) * measure().width / 100;
        if (!offset || Math.abs(offset) > settleRadius) return;

        if (!reducedMotion.matches) {
          // Commit the value immediately and animate the thumb from its prior position.
          input.style.setProperty("--thumb-offset", `${offset}px`);
          input.dataset.settling = "";
          settleTimer = window.setTimeout(stopSettling, 220);
        }
        setValue(nearest.value);
      };

      input.dataset.enhanced = "";
      input.onblur = () => { delete input.dataset.pointerFocus; };
      input.onkeydown = () => {
        stopSettling();
        delete input.dataset.pointerFocus;
      };
      input.ontouchstart = input.ontouchmove = event => {
        // The native touch handler can otherwise overwrite the snapped value after pointermove.
        if (!forcedColors.matches && event.cancelable) event.preventDefault();
      };

      input.onpointerdown = event => {
        if (drag || !event.isPrimary || event.button !== 0) return;
        input.dataset.pointerFocus = "";
        if (forcedColors.matches) return;

        event.preventDefault();
        stopSettling();
        input.focus({ preventScroll: true });
        input.setPointerCapture(event.pointerId);
        const { xAt, centerY, radius, left, width, markAt } = measure();
        const startValue = input.valueAsNumber;
        const onThumb = Math.hypot(event.clientX - xAt(startValue), event.clientY - centerY) <= radius + 2;
        const mark = onThumb ? undefined : markAt(event.clientX, event.clientY);
        const anchor = onThumb ? startValue : mark?.value;
        drag = {
          id: event.pointerId,
          offset: anchor === undefined ? 0 : event.clientX - xAt(anchor),
          startValue,
          snapped: mark?.value,
        };
        input.dataset.dragging = "";
        input.toggleAttribute("data-snapped", !!mark);
        delete input.dataset.thumbHovered;
        highlight();
        if (!onThumb) setValue(mark?.value ?? (event.clientX - left) / width * 100);
      };

      input.onpointermove = event => {
        if (!drag) {
          updateHover(event);
          return;
        }
        if (event.pointerId !== drag.id) return;

        const { xAt, left, width } = measure();
        let x = event.clientX - drag.offset;
        if (drag.snapped !== undefined && Math.abs(x - xAt(drag.snapped)) >= releaseRadius) {
          drag.snapped = undefined;
        }

        const nearby = marks.find(({ value }) => Math.abs(x - xAt(value)) < magnetRadius);
        if (nearby) {
          const anchor = xAt(nearby.value);
          const distance = x - anchor;
          if (Math.abs(distance) <= snapRadius) drag.snapped = nearby.value;
          // Ease into the stop, then hold it through a slightly wider band on the way out.
          const pull = Math.max(0, (Math.abs(distance) - snapRadius) / (magnetRadius - snapRadius));
          x = anchor + distance * pull * pull * (3 - 2 * pull);
        }
        input.toggleAttribute("data-snapped", drag.snapped !== undefined);
        setValue(drag.snapped ?? (x - left) / width * 100);
      };

      input.onpointerup = input.onpointercancel = input.onlostpointercapture = event => {
        if (drag?.id !== event.pointerId) return;
        if (event.type === "pointerup") settle();
        const changed = drag.startValue !== input.valueAsNumber;
        drag = undefined;
        delete input.dataset.dragging;
        delete input.dataset.snapped;
        if (event.type === "pointerup") updateHover(event);
        if (changed) input.dispatchEvent(new Event("change", { bubbles: true }));
      };

      input.onpointerleave = () => {
        delete input.dataset.thumbHovered;
        highlight();
      };
    }
  }

  if (!customElements.get("sensitivity-slider")) customElements.define("sensitivity-slider", SensitivitySlider);
</script>
