---
import { work } from "../data/site";
---
<ul class="work-list" aria-label="Selected work and writing">
  {work.map((entry, index) => <li style={`--work-index:${index}`}>
    <a class="work-link" data-preview={entry.preview ? entry.id : undefined} href={entry.href} target="_blank" rel="noopener noreferrer">
      <span class="work-title">{entry.title}</span>
      <span class="work-detail">{entry.detail}</span>
    </a>
  </li>)}
</ul>
<aside class="work-previews" aria-hidden="true" hidden>
  {work.map(({ id, preview }) => preview && <figure class="work-preview" data-preview-card={id}>
    <img src={preview.image} width={preview.width} height={preview.height} alt="" loading="lazy" decoding="async" />
    <figcaption>{preview.caption}</figcaption>
  </figure>)}
</aside>
<script>
  import "../scripts/work-previews";
</script>
