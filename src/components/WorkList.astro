---
import { work } from "../data/site";
import ExternalArrow from "./ExternalArrow.astro";
---
<ul class="work-list" aria-label="Selected work and writing">
  {work.map(entry => <li>
    <a class="work-link" data-preview={entry.id} href={entry.href} target="_blank" rel="noopener noreferrer">
      <span class="work-title">{entry.title}<ExternalArrow /></span>
      <span class="work-detail">{entry.detail}</span>
    </a>
  </li>)}
</ul>
<aside class="work-previews" aria-hidden="true" hidden>
  {work.map(entry => <figure class="work-preview" data-preview-card={entry.id}>
    {"image" in entry.preview ? <>
      <img src={entry.preview.image} width={entry.preview.width} height={entry.preview.height} alt="" loading="lazy" decoding="async" />
      <figcaption>{entry.title} · Datadog</figcaption>
    </> : <div class="article-preview">
      <p class="article-preview-byline">Matthieu Babe · Writing</p>
      <h2>{entry.title}</h2>
      <blockquote>{entry.preview.quote}</blockquote>
      <p class="article-preview-source">Read on Medium <ExternalArrow /></p>
    </div>}
  </figure>)}
</aside>
<script>
  import "../scripts/work-previews";
</script>
